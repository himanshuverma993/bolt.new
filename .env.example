#
# Copy this file to `.env.local` and enable ONE of the blocks below.
# The dev server (`pnpm run dev`) and `pnpm run start` both read `.env.local`.
# After filling it in, run `pnpm run check-llm` to verify the chain.
#
# On Cloudflare Pages nothing from this file is needed: wrangler.toml already
# selects Workers AI (`[ai]` binding + `[vars]`). See CLOUDFLARE-DEPLOY.md.
#

# ---------------------------------------------------------------------------
# 1. Cloudflare Workers AI (free: 10,000 neurons/day, no credit card)
#
#    a) Local dev through the AI binding: run `npx wrangler login` once, then
#       `pnpm run dev` / `pnpm run start`. Nothing to put in this file, the
#       models come from wrangler.toml.
#    b) Local dev through the REST API (no wrangler login), or any machine
#       outside Cloudflare: account id + an API token with the permission
#       "Account > Workers AI > Read". Both are also accepted as Pages secrets,
#       where they become the fallback transport behind the binding.
# ---------------------------------------------------------------------------
# LLM_PROVIDER=cloudflare
# CLOUDFLARE_ACCOUNT_ID=0123456789abcdef0123456789abcdef
# CLOUDFLARE_API_TOKEN=...
# LLM_MODEL=@cf/google/gemma-4-26b-a4b-it
# LLM_FALLBACK_MODELS=@cf/qwen/qwen2.5-coder-32b-instruct,@cf/meta/llama-4-scout-17b-16e-instruct
# LLM_ENHANCER_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8
#
# Optional Workers AI knobs (no inline comments in .env.local: bindings.sh
# passes the lines verbatim to wrangler):
# - CLOUDFLARE_AI_TRANSPORT: auto (binding first, REST fallback), binding, rest
# - CLOUDFLARE_AI_GATEWAY_ID: route the calls through an AI Gateway
# - LLM_STREAM_COALESCE_MS: merge streamed tokens for N ms (CPU saver), 0 = off
# CLOUDFLARE_AI_TRANSPORT=auto
# CLOUDFLARE_AI_GATEWAY_ID=my-gateway
# LLM_STREAM_COALESCE_MS=80

# ---------------------------------------------------------------------------
# 2. Anthropic Claude (the original Bolt setup)
#    LLM_PROVIDER is needed because wrangler.toml defaults to "cloudflare".
# ---------------------------------------------------------------------------
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-3-5-sonnet-20240620

# ---------------------------------------------------------------------------
# 3. Hugging Face router (free tier): open-weight models from many providers
#    Model id format is "org/model:provider" — check the model page on HF.
# ---------------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://router.huggingface.co/v1
# LLM_API_KEY=hf_...
# LLM_MODEL=zai-org/GLM-5.3:together
# LLM_FALLBACK_MODELS=moonshotai/Kimi-K3:cerebras,deepseek-ai/DeepSeek-V4-Pro:fireworks-ai
# LLM_ENHANCER_MODEL=zai-org/GLM-5.3-Flash:together

# ---------------------------------------------------------------------------
# 4. A local OpenAI-compatible router (your own gateway on this machine)
#    Use "auto" as the model id when the router decides the model itself.
#    NOTE: the app calls this URL from its server, so 127.0.0.1 means
#    "the machine running the app", not your browser.
# ---------------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://127.0.0.1:8787/v1
# LLM_API_KEY=whatever-the-router-expects
# LLM_MODEL=auto
# LLM_FALLBACK_MODELS=glm-5.3:free,nvidia/nemotron-3-ultra-550b-a55b:free

# ---------------------------------------------------------------------------
# 5. No key at all: the bundled mock provider (good for checking the wiring)
#    Run `pnpm run mock-llm` in a second terminal.
# ---------------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://127.0.0.1:8788/v1
# LLM_API_KEY=mock
# LLM_MODEL=mock-fail
# LLM_FALLBACK_MODELS=mock-ok

# ---------------------------------------------------------------------------
# Tuning (all optional, shown with their defaults)
# ---------------------------------------------------------------------------

# Max output tokens per segment. Lower it when a provider caps output lower.
# LLM_MAX_TOKENS=8192

# Retries per model before failing over to the next one (free tiers: keep 0)
# LLM_MAX_RETRIES=0

# Sampling temperature. Default is 0.2 for OpenAI-compatible endpoints
# (some TGI backends reject 0) and 0 for Anthropic.
# LLM_TEMPERATURE=0.2

# Extra headers as JSON (gateway auth, OpenRouter ranking, ...)
# LLM_HEADERS={"HTTP-Referer":"http://localhost:5173","X-Title":"bolt"}

# Extra request-body fields, merged into every request. Useful for vendor
# specific knobs like disabling thinking on some open-weight models.
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# Watchdogs: a stuck provider makes the chain move on instead of hanging.
# LLM_FIRST_TOKEN_TIMEOUT_MS=120000
# LLM_IDLE_TIMEOUT_MS=60000

# A single model entry can cap its own output with "model|maxTokens", e.g.
# LLM_FALLBACK_MODELS=small-model:free|4096,big-model:free
